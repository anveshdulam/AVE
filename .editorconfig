root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cpp,h,hpp,inl,cxx,hxx}]
indent_style = space
indent_size = 4

[*.{cmake,txt}]
indent_style = space
indent_size = 4

[*.{json,qml,js,yaml,yml,md}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

