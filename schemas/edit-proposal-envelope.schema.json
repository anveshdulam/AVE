{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/autonomous-video-editor/edit-proposal-envelope.schema.json",
  "title": "Edit Proposal Envelope",
  "type": "object",
  "required": [
    "schema_version",
    "proposal_id",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "enum": [
        "user",
        "ai",
        "import",
        "script"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "operation_type",
          "target_ids",
          "parameters"
        ],
        "properties": {
          "operation_type": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parameters": {
            "type": "object"
          },
          "requires_approval": {
            "type": "boolean",
            "default": true
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}