CompileFlags:
  CompilationDatabase: build/smoke
  Add:
    - -std=c++20
    - -Icore/include
    - -Imedia/include
    - -Iengines/playback/include
    - -Iengines/audio/include
    - -IC:/VulkanSDK/1.4.363.0/Include
    - -ID:/DevTools/ffmpeg/include
    - -DNOMINMAX
    - -DWIN32_LEAN_AND_MEAN
    - -D_CRT_SECURE_NO_WARNINGS
Diagnostics:
  UnusedIncludes: None
